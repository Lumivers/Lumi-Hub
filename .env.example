# Lumi-Hub 2.0 环境变量配置
# 复制此文件为 .env 并填入你的配置

# === LLM Provider 配置 ===
# 可选: openai | anthropic | ollama
LUMI_LLM_PROVIDER=openai

# API Key (OpenAI 或 Anthropic)
LUMI_LLM_API_KEY=sk-your-api-key-here

# 自定义 Base URL (用于 OpenAI 兼容 API，如 Deepseek、Moonshot 等)
# LUMI_LLM_BASE_URL=https://api.deepseek.com/v1

# 默认模型
# LUMI_LLM_MODEL=gpt-4o

# Ollama 配置 (仅当 LUMI_LLM_PROVIDER=ollama 时)
# LUMI_OLLAMA_URL=http://localhost:11434/v1

# === WebSocket 配置 ===
# LUMI_WS_HOST=0.0.0.0
# LUMI_WS_PORT=8765
# LUMI_WS_ACCESS_KEY=your-secret-key

# === 语音配置 ===
# LUMI_VOICE_PROVIDER=dashscope
# LUMI_DASHSCOPE_VOICE_ID=
# LUMI_DASHSCOPE_API_KEY=
